// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



model StudentFee {
  id Int @id @default(autoincrement())

  // Student Information
  class       String
  studentName String
  fatherName  String

  // Previous Year (Last Year) Fees
  previousFees     Float @default(0)
  previousDeposit  Float @default(0)
  previousDiscount Float @default(0)
  previousDue      Float @default(0)

  // Current School Fees
  schoolFees     Float @default(0)
  schoolDeposit  Float @default(0)
  schoolDiscount Float @default(0)
  schoolDue      Float @default(0)

  // Current Bus / Vehicle Fees
  busFees     Float @default(0)
  busDeposit  Float @default(0)
  busDiscount Float @default(0)
  busDue      Float @default(0)

  // Extra / Miscellaneous Fees
  extraFees     Float @default(0)
  extraDeposit  Float @default(0)
  extraDiscount Float @default(0)
  extraDue      Float @default(0)

  // Grand Totals
  totalFees     Float @default(0)
  totalDeposit  Float @default(0)
  totalDiscount Float @default(0)
  totalDue      Float @default(0)

  // Metadata
  academicYear String   @default("2024-25")
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================================
// V2 SCHEMA — normalized fees management (School ERP foundation)
// The legacy StudentFee model above is kept as-is; everything below is new.
// ============================================================================

enum FeeCategory {
  SCHOOL
  BUS
  OTHER
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  COMPLETED
  TRANSFERRED
  DROPPED
}

enum PaymentMode {
  CASH
  ONLINE
  CHEQUE
  BANK_TRANSFER
  CARD
  OTHER
}

enum TransactionStatus {
  COMPLETED
  CANCELLED
}

// An academic session/year, e.g. "2024-25". Exactly one should be current.
model AcademicSession {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classrooms      Classroom[]
  enrollments     StudentEnrollment[]
  feeStructures   FeeStructure[]
  calendarEvents  CalendarEvent[]
}

// Class master (session-independent), e.g. "LKG", "I", "X".
model SchoolClass {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  classrooms    Classroom[]
  feeStructures FeeStructure[]
  chapters      Chapter[]
}

// A class running in a specific session (optionally split into sections).
// Student enrollments point here, giving every enrollment a session + class.
model Classroom {
  id        Int      @id @default(autoincrement())
  classId   Int
  sessionId Int
  section   String   @default("A")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class       SchoolClass         @relation(fields: [classId], references: [id])
  session     AcademicSession     @relation(fields: [sessionId], references: [id])
  enrollments StudentEnrollment[]
  assignments TeacherAssignment[]

  @@unique([classId, sessionId, section])
  @@index([sessionId])
}

// Student master data — one row per person, across all sessions.
model Student {
  id                 Int       @id @default(autoincrement())
  admissionNo        String?   @unique
  name               String
  fatherName         String
  motherName         String?
  phone              String?
  address            String?
  gender             String?
  dateOfBirth        DateTime?
  isActive           Boolean   @default(true)
  remarks            String?
  // Link back to the legacy StudentFee row this student was migrated from.
  legacyStudentFeeId Int?      @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  enrollments  StudentEnrollment[]
  transactions FeeTransaction[]

  @@index([name])
}

// A student's membership in a classroom for one session.
// All fees hang off the enrollment, so dues are tracked per session.
model StudentEnrollment {
  id          Int              @id @default(autoincrement())
  studentId   Int
  sessionId   Int
  classroomId Int
  rollNo      Int?
  status      EnrollmentStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  student   Student         @relation(fields: [studentId], references: [id])
  session   AcademicSession @relation(fields: [sessionId], references: [id])
  classroom Classroom       @relation(fields: [classroomId], references: [id])
  feeItems  StudentFeeItem[]

  @@unique([studentId, sessionId])
  @@index([classroomId])
  @@index([sessionId])
}

// Class-wise fee template for a session. Assigning it to a student copies
// its items into StudentFeeItem rows, which the admin can then edit freely.
model FeeStructure {
  id        Int      @id @default(autoincrement())
  sessionId Int
  classId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session AcademicSession    @relation(fields: [sessionId], references: [id])
  class   SchoolClass        @relation(fields: [classId], references: [id])
  items   FeeStructureItem[]

  @@unique([sessionId, classId])
}

model FeeStructureItem {
  id               Int         @id @default(autoincrement())
  feeStructureId   Int
  category         FeeCategory
  name             String
  amount           Decimal     @db.Decimal(12, 2)
  installmentCount Int         @default(1)

  feeStructure FeeStructure     @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeItems     StudentFeeItem[]

  @@unique([feeStructureId, name])
}

// A fee assigned to one enrollment (e.g. "School Fees 2024-25" for one
// student). Aggregates are kept in sync with the installments beneath it:
//   netAmount = originalAmount - discountAmount
//   dueAmount = netAmount - paidAmount
model StudentFeeItem {
  id              Int         @id @default(autoincrement())
  enrollmentId    Int
  structureItemId Int?
  category        FeeCategory
  name            String
  originalAmount  Decimal     @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)
  netAmount       Decimal     @db.Decimal(12, 2)
  paidAmount      Decimal     @default(0) @db.Decimal(12, 2)
  dueAmount       Decimal     @db.Decimal(12, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  enrollment    StudentEnrollment @relation(fields: [enrollmentId], references: [id])
  structureItem FeeStructureItem? @relation(fields: [structureItemId], references: [id], onDelete: SetNull)
  installments  FeeInstallment[]
  discounts     FeeDiscount[]

  @@index([enrollmentId])
  @@index([category])
}

// One installment of a fee item. Payments are allocated at this level.
// Same invariants as the fee item: netAmount = originalAmount - discountAmount.
model FeeInstallment {
  id             Int               @id @default(autoincrement())
  feeItemId      Int
  sequence       Int
  label          String
  dueDate        DateTime?
  originalAmount Decimal           @db.Decimal(12, 2)
  discountAmount Decimal           @default(0) @db.Decimal(12, 2)
  netAmount      Decimal           @db.Decimal(12, 2)
  paidAmount     Decimal           @default(0) @db.Decimal(12, 2)
  status         InstallmentStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  feeItem     StudentFeeItem          @relation(fields: [feeItemId], references: [id], onDelete: Cascade)
  allocations TransactionAllocation[]

  @@unique([feeItemId, sequence])
  @@index([status])
}

// Audit trail of discounts applied to a fee item. Applying a discount only
// reduces UNPAID installment amounts — paid installments are never touched.
model FeeDiscount {
  id        Int      @id @default(autoincrement())
  feeItemId Int
  amount    Decimal  @db.Decimal(12, 2)
  reason    String?
  appliedBy String?
  createdAt DateTime @default(now())

  feeItem StudentFeeItem @relation(fields: [feeItemId], references: [id], onDelete: Cascade)
}

// A payment made by/for a student. `category` records which fee type the
// payment was for; the allocation engine distributes it into installments
// (past-session dues first, see src/lib/fees/allocation.ts).
model FeeTransaction {
  id        Int               @id @default(autoincrement())
  receiptNo String            @unique
  studentId Int
  category  FeeCategory?
  amount    Decimal           @db.Decimal(12, 2)
  mode      PaymentMode       @default(CASH)
  reference String?
  remarks   String?
  status    TransactionStatus @default(COMPLETED)
  paidAt    DateTime          @default(now())
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  student     Student                 @relation(fields: [studentId], references: [id])
  allocations TransactionAllocation[]

  @@index([studentId])
  @@index([paidAt])
}

// How a transaction's amount was split across installments.
// sum(allocations.amount) = transaction.amount for COMPLETED transactions.
model TransactionAllocation {
  id            Int      @id @default(autoincrement())
  transactionId Int
  installmentId Int
  amount        Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  transaction FeeTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  installment FeeInstallment @relation(fields: [installmentId], references: [id])

  @@index([transactionId])
  @@index([installmentId])
}

// ============================================================================
// AUTH — accounts that may access the fees management system
// ============================================================================

enum UserRole {
  SUPERUSER
  ADMIN
}

// An account that may access the fees system. Login is by mobile number.
// Passwords are stored as scrypt hashes ("scrypt$<salt>$<hash>"); sessions
// are stateless signed cookies, so no session table is needed.
//
// The single SUPERUSER is created out-of-band via `npm run db:create-superuser`
// and is the only account allowed to create/manage ADMIN accounts in the app.
model User {
  id           Int       @id @default(autoincrement())
  phone        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([phone])
}

// ============================================================================
// TEACHER & SYLLABUS MODULE
// Layered on top of the fees schema above. AcademicSession, SchoolClass,
// Classroom and User are reused as-is (see back-relations added above).
// Admins and teachers are two entirely separate systems: separate identity
// table, separate password store, separate session cookie, separate route
// namespace. Teacher/User cross-references (createdById, assignedById,
// markedById) are soft Int columns, not Prisma relations — see AGENTS docs.
// ============================================================================

enum SessionType {
  TEACHING
  REVISION
  QA
  TEST
}

enum TopicStatus {
  PARTIAL
  COMPLETE
}

enum PacingStatus {
  ON_TRACK
  BEHIND
  AHEAD
  COMPLETED
}

enum ActorType {
  ADMIN
  TEACHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum CalendarEventType {
  HOLIDAY
  EXAM
  EVENT
}

// The teacher identity table. Structurally parallel to User, but independent
// — see AGENTS docs for why teachers are not folded into the User/UserRole model.
model Teacher {
  id            Int       @id @default(autoincrement())
  employeeId    String    @unique
  name          String
  phone         String    @unique
  email         String?   @unique
  passwordHash  String
  qualification String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdById   Int? // User.id of the creating admin — soft reference
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignments TeacherAssignment[]
  attendance  TeacherAttendance[]

  @@index([employeeId])
  @@index([phone])
}

// Subject master — Physics, Mathematics, and so on.
model Subject {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  code         String?  @unique
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chapters    Chapter[]
  assignments TeacherAssignment[]
}

// Chapters, scoped to a (subject, class) pair — the same subject has a
// different syllabus at each class level.
model Chapter {
  id              Int      @id @default(autoincrement())
  subjectId       Int
  classId         Int
  name            String
  displayOrder    Int
  periodsRequired Int? // estimated teaching periods; feeds the pacing engine
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subject Subject     @relation(fields: [subjectId], references: [id])
  class   SchoolClass @relation(fields: [classId], references: [id])

  topics       Topic[]
  pacing       SyllabusPacing[]
  topicDetails SessionTopicDetail[]

  @@unique([subjectId, classId, name])
  @@index([subjectId, classId])
}

// Topics inside a chapter — the intermediate grouping between a chapter and
// its subtopics. A chapter contains topics; each topic contains subtopics.
model Topic {
  id           Int      @id @default(autoincrement())
  chapterId    Int
  name         String
  displayOrder Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chapter   Chapter    @relation(fields: [chapterId], references: [id])
  subtopics Subtopic[]

  @@index([chapterId])
}

// Subtopics inside a topic — the level at which teaching completion is marked.
model Subtopic {
  id           Int      @id @default(autoincrement())
  topicId      Int
  name         String
  displayOrder Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  topic        Topic                @relation(fields: [topicId], references: [id])
  topicDetails SessionTopicDetail[]

  @@index([topicId])
}

// Links a teacher to a classroom (which already encodes class + section +
// academic session) and subject: "this teacher teaches this subject to this
// section this year". Deactivating preserves historical session logs.
model TeacherAssignment {
  id           Int      @id @default(autoincrement())
  teacherId    Int
  classroomId  Int
  subjectId    Int
  isActive     Boolean  @default(true)
  assignedById Int? // User.id of the assigning admin — soft reference
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacher   Teacher   @relation(fields: [teacherId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])
  subject   Subject   @relation(fields: [subjectId], references: [id])

  timetableSlots TimetableSlot[]
  sessionLogs    SessionLog[]
  pacing         SyllabusPacing[]

  @@unique([teacherId, classroomId, subjectId])
  @@index([classroomId])
  @@index([teacherId])
}

// Period-wise weekly schedule. Reference only — SessionLog has no FK here,
// see SessionLog for why.
model TimetableSlot {
  id           Int      @id @default(autoincrement())
  assignmentId Int
  dayOfWeek    Int // 1 = Monday ... 6 = Saturday
  periodNumber Int
  startTime    String // "HH:mm"
  endTime      String // "HH:mm"
  roomLabel    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment TeacherAssignment @relation(fields: [assignmentId], references: [id])

  @@unique([assignmentId, dayOfWeek, periodNumber])
  @@index([dayOfWeek])
}

// Holidays, exams and events attached to an academic session. Feeds the
// working-days calculation that drives the pacing engine.
model CalendarEvent {
  id          Int               @id @default(autoincrement())
  sessionId   Int
  title       String
  type        CalendarEventType
  startDate   DateTime          @db.Date
  endDate     DateTime          @db.Date
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  session AcademicSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([startDate, endDate])
}

// A logged teaching, revision, Q&A or test session — the header. No timetable
// foreign key: a teacher who arrived late, swapped periods, or covered an
// absent colleague's class must still be able to record what they actually
// taught. Timetable stays a planning artefact; logging stays free-form.
model SessionLog {
  id           Int         @id @default(autoincrement())
  assignmentId Int
  sessionDate  DateTime    @db.Date
  type         SessionType
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  assignment TeacherAssignment    @relation(fields: [assignmentId], references: [id])
  topics     SessionTopicDetail[]

  @@index([assignmentId])
  @@index([sessionDate])
}

// Which subtopics/chapters a session covered. TEACHING/REVISION rows point at
// a subtopic; QA/TEST rows point at a chapter (coarser granularity — a Q&A or
// test spans the whole chapter, not one subtopic).
model SessionTopicDetail {
  id           Int         @id @default(autoincrement())
  sessionLogId Int
  subtopicId   Int?
  chapterId    Int?
  status       TopicStatus @default(COMPLETE)
  notes        String?
  createdAt    DateTime    @default(now())

  sessionLog SessionLog @relation(fields: [sessionLogId], references: [id], onDelete: Cascade)
  subtopic   Subtopic?  @relation(fields: [subtopicId], references: [id])
  chapter    Chapter?   @relation(fields: [chapterId], references: [id])

  @@index([sessionLogId])
  @@index([subtopicId])
  @@index([chapterId])
}

// Derived pacing data — never written by a human, always recomputed. One row
// per (assignment, chapter) pair, refreshed nightly and on demand whenever
// the calendar or a teacher's attendance changes.
model SyllabusPacing {
  id                Int          @id @default(autoincrement())
  assignmentId      Int
  chapterId         Int
  expectedStartDate DateTime?    @db.Date
  expectedEndDate   DateTime?    @db.Date
  status            PacingStatus @default(ON_TRACK)
  daysBehind        Int? // positive = behind, negative = ahead, zero = on schedule
  completionPercent Int          @default(0)
  calculatedAt      DateTime     @default(now())

  assignment TeacherAssignment @relation(fields: [assignmentId], references: [id])
  chapter    Chapter           @relation(fields: [chapterId], references: [id])

  @@unique([assignmentId, chapterId])
  @@index([status])
}

// Daily attendance, written by admin.
model TeacherAttendance {
  id         Int              @id @default(autoincrement())
  teacherId  Int
  date       DateTime         @db.Date
  status     AttendanceStatus
  remarks    String?
  markedById Int? // User.id of the recording admin — soft reference
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, date])
  @@index([date])
}

// Immutable action log. Admins live in User, teachers live in Teacher — there
// is no single table a foreign key could point at, so the actor is stored
// polymorphically. actorName is a denormalised snapshot so the log stays
// readable even after the actor account is gone.
model TeachingAuditLog {
  id         Int       @id @default(autoincrement())
  actorType  ActorType
  actorId    Int
  actorName  String
  action     String
  entityType String
  entityId   Int?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([actorType, actorId])
  @@index([createdAt])
}
