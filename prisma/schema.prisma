// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model StudentFee {
  id Int @id @default(autoincrement())

  // Student Information
  class       String
  studentName String
  fatherName  String

  // Previous Year (Last Year) Fees
  previousFees     Float @default(0)
  previousDeposit  Float @default(0)
  previousDiscount Float @default(0)
  previousDue      Float @default(0)

  // Current School Fees
  schoolFees     Float @default(0)
  schoolDeposit  Float @default(0)
  schoolDiscount Float @default(0)
  schoolDue      Float @default(0)

  // Current Bus / Vehicle Fees
  busFees     Float @default(0)
  busDeposit  Float @default(0)
  busDiscount Float @default(0)
  busDue      Float @default(0)

  // Extra / Miscellaneous Fees
  extraFees     Float @default(0)
  extraDeposit  Float @default(0)
  extraDiscount Float @default(0)
  extraDue      Float @default(0)

  // Grand Totals
  totalFees     Float @default(0)
  totalDeposit  Float @default(0)
  totalDiscount Float @default(0)
  totalDue      Float @default(0)

  // Metadata
  academicYear String   @default("2024-25")
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================================
// V2 SCHEMA — normalized fees management (School ERP foundation)
// The legacy StudentFee model above is kept as-is; everything below is new.
// ============================================================================

enum FeeCategory {
  SCHOOL
  BUS
  OTHER
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  COMPLETED
  TRANSFERRED
  DROPPED
}

enum PaymentMode {
  CASH
  ONLINE
  CHEQUE
  BANK_TRANSFER
  CARD
  OTHER
}

enum TransactionStatus {
  COMPLETED
  CANCELLED
}

// An academic session/year, e.g. "2024-25". Exactly one should be current.
model AcademicSession {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classrooms      Classroom[]
  enrollments     StudentEnrollment[]
  feeStructures   FeeStructure[]
  calendarEvents  CalendarEvent[]
  recoveryCases   RecoveryCase[]
  contactAttempts ContactAttempt[]
  promises        PromiseToPay[]
  forecasts       CollectionForecast[]
}

// Class master (session-independent), e.g. "LKG", "I", "X".
model SchoolClass {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  classrooms    Classroom[]
  feeStructures FeeStructure[]
  chapters      Chapter[]
}

// A class running in a specific session (optionally split into sections).
// Student enrollments point here, giving every enrollment a session + class.
model Classroom {
  id        Int      @id @default(autoincrement())
  classId   Int
  sessionId Int
  section   String   @default("A")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class       SchoolClass         @relation(fields: [classId], references: [id])
  session     AcademicSession     @relation(fields: [sessionId], references: [id])
  enrollments StudentEnrollment[]
  assignments TeacherAssignment[]

  @@unique([classId, sessionId, section])
  @@index([sessionId])
}

// Student master data — one row per person, across all sessions.
model Student {
  id                 Int       @id @default(autoincrement())
  admissionNo        String?   @unique
  name               String
  fatherName         String
  motherName         String?
  phone              String?
  address            String?
  gender             String?
  dateOfBirth        DateTime?
  isActive           Boolean   @default(true)
  remarks            String?
  // Link back to the legacy StudentFee row this student was migrated from.
  legacyStudentFeeId Int?      @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  enrollments  StudentEnrollment[]
  transactions FeeTransaction[]
  guardians    GuardianStudent[]

  @@index([name])
}

// A student's membership in a classroom for one session.
// All fees hang off the enrollment, so dues are tracked per session.
model StudentEnrollment {
  id          Int              @id @default(autoincrement())
  studentId   Int
  sessionId   Int
  classroomId Int
  rollNo      Int?
  status      EnrollmentStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  student   Student          @relation(fields: [studentId], references: [id])
  session   AcademicSession  @relation(fields: [sessionId], references: [id])
  classroom Classroom        @relation(fields: [classroomId], references: [id])
  feeItems  StudentFeeItem[]

  @@unique([studentId, sessionId])
  @@index([classroomId])
  @@index([sessionId])
}

// Class-wise fee template for a session. Assigning it to a student copies
// its items into StudentFeeItem rows, which the admin can then edit freely.
model FeeStructure {
  id        Int      @id @default(autoincrement())
  sessionId Int
  classId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session AcademicSession    @relation(fields: [sessionId], references: [id])
  class   SchoolClass        @relation(fields: [classId], references: [id])
  items   FeeStructureItem[]

  @@unique([sessionId, classId])
}

model FeeStructureItem {
  id               Int         @id @default(autoincrement())
  feeStructureId   Int
  category         FeeCategory
  name             String
  amount           Decimal     @db.Decimal(12, 2)
  installmentCount Int         @default(1)

  feeStructure FeeStructure              @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeItems     StudentFeeItem[]
  schedule     FeeStructureInstallment[]

  @@unique([feeStructureId, name])
}

// The due-date schedule for a structure item. Optional: an item with no
// schedule rows still splits into `installmentCount` equal, undated
// installments (the pre-recovery behaviour). When rows are present they are
// copied onto every student's installments, which is what makes
// "installment 2 collects late" answerable at all.
model FeeStructureInstallment {
  id              Int      @id @default(autoincrement())
  structureItemId Int
  sequence        Int
  label           String?
  dueDate         DateTime @db.Date
  // Optional explicit amount; null means "even split of the item amount".
  amount          Decimal? @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  structureItem FeeStructureItem @relation(fields: [structureItemId], references: [id], onDelete: Cascade)

  @@unique([structureItemId, sequence])
}

// A fee assigned to one enrollment (e.g. "School Fees 2024-25" for one
// student). Aggregates are kept in sync with the installments beneath it:
//   netAmount = originalAmount - discountAmount
//   dueAmount = netAmount - paidAmount
model StudentFeeItem {
  id              Int         @id @default(autoincrement())
  enrollmentId    Int
  structureItemId Int?
  category        FeeCategory
  name            String
  originalAmount  Decimal     @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)
  netAmount       Decimal     @db.Decimal(12, 2)
  paidAmount      Decimal     @default(0) @db.Decimal(12, 2)
  dueAmount       Decimal     @db.Decimal(12, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  enrollment    StudentEnrollment @relation(fields: [enrollmentId], references: [id])
  structureItem FeeStructureItem? @relation(fields: [structureItemId], references: [id], onDelete: SetNull)
  installments  FeeInstallment[]
  discounts     FeeDiscount[]

  @@index([enrollmentId])
  @@index([category])
}

// One installment of a fee item. Payments are allocated at this level.
// Same invariants as the fee item: netAmount = originalAmount - discountAmount.
model FeeInstallment {
  id             Int               @id @default(autoincrement())
  feeItemId      Int
  sequence       Int
  label          String
  dueDate        DateTime?
  originalAmount Decimal           @db.Decimal(12, 2)
  discountAmount Decimal           @default(0) @db.Decimal(12, 2)
  netAmount      Decimal           @db.Decimal(12, 2)
  paidAmount     Decimal           @default(0) @db.Decimal(12, 2)
  status         InstallmentStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  feeItem     StudentFeeItem          @relation(fields: [feeItemId], references: [id], onDelete: Cascade)
  allocations TransactionAllocation[]

  @@unique([feeItemId, sequence])
  @@index([status])
}

// Audit trail of discounts applied to a fee item. Applying a discount only
// reduces UNPAID installment amounts — paid installments are never touched.
model FeeDiscount {
  id        Int      @id @default(autoincrement())
  feeItemId Int
  amount    Decimal  @db.Decimal(12, 2)
  reason    String?
  appliedBy String?
  createdAt DateTime @default(now())

  feeItem StudentFeeItem @relation(fields: [feeItemId], references: [id], onDelete: Cascade)
}

// A payment made by/for a student. `category` records which fee type the
// payment was for; the allocation engine distributes it into installments
// (past-session dues first, see src/lib/fees/allocation.ts).
model FeeTransaction {
  id        Int               @id @default(autoincrement())
  receiptNo String            @unique
  studentId Int
  category  FeeCategory?
  amount    Decimal           @db.Decimal(12, 2)
  mode      PaymentMode       @default(CASH)
  reference String?
  remarks   String?
  status    TransactionStatus @default(COMPLETED)
  paidAt    DateTime          @default(now())
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  student     Student                 @relation(fields: [studentId], references: [id])
  allocations TransactionAllocation[]

  @@index([studentId])
  @@index([paidAt])
}

// How a transaction's amount was split across installments.
// sum(allocations.amount) = transaction.amount for COMPLETED transactions.
model TransactionAllocation {
  id            Int      @id @default(autoincrement())
  transactionId Int
  installmentId Int
  amount        Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  transaction FeeTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  installment FeeInstallment @relation(fields: [installmentId], references: [id])

  @@index([transactionId])
  @@index([installmentId])
}

// ============================================================================
// AUTH — accounts that may access the fees management system
// ============================================================================

enum UserRole {
  SUPERUSER
  ADMIN
}

// An account that may access the fees system. Login is by mobile number.
// Passwords are stored as scrypt hashes ("scrypt$<salt>$<hash>"); sessions
// are stateless signed cookies, so no session table is needed.
//
// The single SUPERUSER is created out-of-band via `npm run db:create-superuser`
// and is the only account allowed to create/manage ADMIN accounts in the app.
model User {
  id           Int       @id @default(autoincrement())
  phone        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([phone])
}

// ============================================================================
// TEACHER & SYLLABUS MODULE
// Layered on top of the fees schema above. AcademicSession, SchoolClass,
// Classroom and User are reused as-is (see back-relations added above).
// Admins and teachers are two entirely separate systems: separate identity
// table, separate password store, separate session cookie, separate route
// namespace. Teacher/User cross-references (createdById, assignedById,
// markedById) are soft Int columns, not Prisma relations — see AGENTS docs.
// ============================================================================

enum SessionType {
  TEACHING
  REVISION
  QA
  TEST
  HOMEWORK
}

enum TopicStatus {
  PARTIAL
  COMPLETE
}

enum PacingStatus {
  ON_TRACK
  BEHIND
  AHEAD
  COMPLETED
}

enum ActorType {
  ADMIN
  TEACHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum CalendarEventType {
  HOLIDAY
  EXAM
  EVENT
}

// The teacher identity table. Structurally parallel to User, but independent
// — see AGENTS docs for why teachers are not folded into the User/UserRole model.
model Teacher {
  id            Int       @id @default(autoincrement())
  employeeId    String    @unique
  name          String
  phone         String    @unique
  email         String?   @unique
  passwordHash  String
  qualification String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdById   Int? // User.id of the creating admin — soft reference
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignments    TeacherAssignment[]
  attendance     TeacherAttendance[]
  homeworkChecks HomeworkCheck[]

  @@index([employeeId])
  @@index([phone])
}

// Subject master — Physics, Mathematics, and so on.
model Subject {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  code         String?  @unique
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chapters    Chapter[]
  assignments TeacherAssignment[]
}

// Chapters, scoped to a (subject, class) pair — the same subject has a
// different syllabus at each class level.
model Chapter {
  id              Int      @id @default(autoincrement())
  subjectId       Int
  classId         Int
  name            String
  displayOrder    Int
  periodsRequired Int? // estimated teaching periods; feeds the pacing engine
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subject Subject     @relation(fields: [subjectId], references: [id])
  class   SchoolClass @relation(fields: [classId], references: [id])

  topics       Topic[]
  pacing       SyllabusPacing[]
  topicDetails SessionTopicDetail[]

  @@unique([subjectId, classId, name])
  @@index([subjectId, classId])
}

// Topics inside a chapter — the intermediate grouping between a chapter and
// its subtopics. A chapter contains topics; each topic contains subtopics.
model Topic {
  id           Int      @id @default(autoincrement())
  chapterId    Int
  name         String
  displayOrder Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chapter   Chapter    @relation(fields: [chapterId], references: [id])
  subtopics Subtopic[]

  @@index([chapterId])
}

// Subtopics inside a topic — the level at which teaching completion is marked.
model Subtopic {
  id           Int      @id @default(autoincrement())
  topicId      Int
  name         String
  displayOrder Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  topic        Topic                @relation(fields: [topicId], references: [id])
  topicDetails SessionTopicDetail[]

  @@index([topicId])
}

// Links a teacher to a classroom (which already encodes class + section +
// academic session) and subject: "this teacher teaches this subject to this
// section this year". Deactivating preserves historical session logs.
model TeacherAssignment {
  id           Int      @id @default(autoincrement())
  teacherId    Int
  classroomId  Int
  subjectId    Int
  isActive     Boolean  @default(true)
  assignedById Int? // User.id of the assigning admin — soft reference
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacher   Teacher   @relation(fields: [teacherId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])
  subject   Subject   @relation(fields: [subjectId], references: [id])

  timetableSlots TimetableSlot[]
  sessionLogs    SessionLog[]
  pacing         SyllabusPacing[]

  @@unique([teacherId, classroomId, subjectId])
  @@index([classroomId])
  @@index([teacherId])
}

// Period-wise weekly schedule. Reference only — SessionLog has no FK here,
// see SessionLog for why.
model TimetableSlot {
  id           Int      @id @default(autoincrement())
  assignmentId Int
  dayOfWeek    Int // 1 = Monday ... 6 = Saturday
  periodNumber Int
  startTime    String // "HH:mm"
  endTime      String // "HH:mm"
  roomLabel    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment TeacherAssignment @relation(fields: [assignmentId], references: [id])

  @@unique([assignmentId, dayOfWeek, periodNumber])
  @@index([dayOfWeek])
}

// Holidays, exams and events attached to an academic session. Feeds the
// working-days calculation that drives the pacing engine.
model CalendarEvent {
  id          Int               @id @default(autoincrement())
  sessionId   Int
  title       String
  type        CalendarEventType
  startDate   DateTime          @db.Date
  endDate     DateTime          @db.Date
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  session AcademicSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([startDate, endDate])
}

// A logged teaching, revision, Q&A, test or homework session — the header. No
// timetable foreign key: a teacher who arrived late, swapped periods, or
// covered an absent colleague's class must still be able to record what they
// actually taught. Timetable stays a planning artefact; logging stays free-form.
//
// HOMEWORK rows are "homework set on this date, covering these subtopics".
// Whether that homework was later checked lives in HomeworkCheck, not here.
model SessionLog {
  id           Int         @id @default(autoincrement())
  assignmentId Int
  sessionDate  DateTime    @db.Date
  type         SessionType
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  assignment    TeacherAssignment    @relation(fields: [assignmentId], references: [id])
  topics        SessionTopicDetail[]
  homeworkCheck HomeworkCheck?

  @@index([assignmentId])
  @@index([sessionDate])
}

// Which subtopics/chapters a session covered. TEACHING/REVISION rows point at
// a subtopic; QA/TEST rows point at a chapter (coarser granularity — a Q&A or
// test spans the whole chapter, not one subtopic).
model SessionTopicDetail {
  id           Int         @id @default(autoincrement())
  sessionLogId Int
  subtopicId   Int?
  chapterId    Int?
  status       TopicStatus @default(COMPLETE)
  notes        String?
  createdAt    DateTime    @default(now())

  sessionLog SessionLog @relation(fields: [sessionLogId], references: [id], onDelete: Cascade)
  subtopic   Subtopic?  @relation(fields: [subtopicId], references: [id])
  chapter    Chapter?   @relation(fields: [chapterId], references: [id])

  @@index([sessionLogId])
  @@index([subtopicId])
  @@index([chapterId])
}

// Records that a HOMEWORK SessionLog's work was actually checked. The row's
// absence is what "not checked yet" means, so there is no boolean flag to keep
// in sync and no ambiguity about a NULL date.
//
// Homework is set on one day and checked on a later one, so three separate
// times are kept: `sessionLog.sessionDate` (the day the homework was set),
// `checkedOn` (the calendar day the teacher actually went through the copies —
// which they choose, since they may record it a day late) and `checkedAt` (the
// server timestamp the record was written, which they cannot choose).
model HomeworkCheck {
  id                 Int      @id @default(autoincrement())
  sessionLogId       Int      @unique
  checkedByTeacherId Int
  checkedOn          DateTime @db.Date
  checkedAt          DateTime @default(now())
  remarks            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessionLog SessionLog @relation(fields: [sessionLogId], references: [id], onDelete: Cascade)
  checkedBy  Teacher    @relation(fields: [checkedByTeacherId], references: [id])

  @@index([checkedOn])
  @@index([checkedByTeacherId])
}

// Derived pacing data — never written by a human, always recomputed. One row
// per (assignment, chapter) pair, refreshed nightly and on demand whenever
// the calendar or a teacher's attendance changes.
model SyllabusPacing {
  id                Int          @id @default(autoincrement())
  assignmentId      Int
  chapterId         Int
  expectedStartDate DateTime?    @db.Date
  expectedEndDate   DateTime?    @db.Date
  status            PacingStatus @default(ON_TRACK)
  daysBehind        Int? // positive = behind, negative = ahead, zero = on schedule
  completionPercent Int          @default(0)
  calculatedAt      DateTime     @default(now())

  assignment TeacherAssignment @relation(fields: [assignmentId], references: [id])
  chapter    Chapter           @relation(fields: [chapterId], references: [id])

  @@unique([assignmentId, chapterId])
  @@index([status])
}

// Daily attendance, written by admin.
model TeacherAttendance {
  id         Int              @id @default(autoincrement())
  teacherId  Int
  date       DateTime         @db.Date
  status     AttendanceStatus
  remarks    String?
  markedById Int? // User.id of the recording admin — soft reference
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, date])
  @@index([date])
}

// Immutable action log. Admins live in User, teachers live in Teacher — there
// is no single table a foreign key could point at, so the actor is stored
// polymorphically. actorName is a denormalised snapshot so the log stays
// readable even after the actor account is gone.
model TeachingAuditLog {
  id         Int       @id @default(autoincrement())
  actorType  ActorType
  actorId    Int
  actorName  String
  action     String
  entityType String
  entityId   Int?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([actorType, actorId])
  @@index([createdAt])
}

// ============================================================================
// FEE RECOVERY MODULE
// Sits on top of the v2 fees ledger; reads it, never writes to it. The ledger
// stays the only source of truth for money — everything here is either
// (a) derived and recomputable, or (b) a record of human contact.
//
// The module separates two things that are constantly conflated when chasing
// fees, and keeping them apart is the whole point:
//   PaymentArchetype — WHEN/WHETHER a family pays (derived from history)
//   EconomicTier     — WHETHER THEY CAN pay (human judgement, system-suggested)
// A family that is able but slow is worth a phone call; a family that is
// willing but broke needs a payment plan, and calling them harder collects
// nothing. Ranking on outstanding alone cannot tell those two apart.
// ============================================================================

// How a family pays, derived from their payment history. Ordered roughly
// worst → best. Assigned by the rule cascade in src/lib/recovery/archetype.ts,
// which also emits the plain-English evidence shown next to the label.
enum PaymentArchetype {
  CHRONIC_DEFAULTER // dues open in 2+ sessions at once
  NEXT_YEAR_PAYER // pays last session's dues while this one goes uncollected
  HEAVY_ROLLOVER // ≤50% paid by year end; the bulk rolls forward
  YEAR_END_PARTIAL // pays late and leaves a residue that carries forward
  YEAR_END_FULL // clears fully, but most of it lands in the last quarter
  INSTALLMENT_REGULAR // pays each installment near its due date; clears in year
  EARLY_FULL // clears almost everything in the first installment window
  UNKNOWN // not enough history to say
}

// Ability to pay. Never inferred alone — the system proposes, a human confirms
// (Guardian.economicTier is the confirmed value, GuardianProfile.suggestedTier
// the proposal). A wrong guess here sends a struggling family to the call list
// and lets a wealthy late-payer off, so the human tag always wins.
enum EconomicTier {
  AFFLUENT
  COMFORTABLE
  STRAINED
  POOR
  SEVERE
  UNKNOWN
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum ContactChannel {
  CALL
  SMS
  WHATSAPP
  VISIT
  IN_PERSON
  OTHER
}

enum ContactOutcome {
  PROMISED
  PAID_ALREADY
  NEEDS_TIME
  REFUSED
  DISPUTED
  CALL_BACK_LATER
  NO_ANSWER
  SWITCHED_OFF
  WRONG_NUMBER
}

enum PromiseStatus {
  OPEN
  KEPT
  PARTIAL
  BROKEN
  CANCELLED
}

enum RecoveryStage {
  NEW
  CONTACTED
  PROMISED
  PARTIAL
  RECOVERED
  SNOOZED
  PARKED
  ESCALATED
}

// The payer. Fees are chased per household, not per child: one father with
// three children is one phone call and one behavioural profile, not three.
// `normalizedName` is the matching key used by prisma/link-guardians.ts.
model Guardian {
  id             Int              @id @default(autoincrement())
  name           String
  normalizedName String
  phone          String?
  altPhone       String?
  relation       GuardianRelation @default(FATHER)
  occupation     String?
  address        String?
  notes          String?

  // Confirmed ability to pay. Set by a human; sticky across recomputes.
  economicTier EconomicTier @default(UNKNOWN)
  tierSetById  Int? // User.id of the admin who set it — soft reference
  tierSetAt    DateTime?
  tierNote     String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students GuardianStudent[]
  profile  GuardianProfile?
  cases    RecoveryCase[]
  contacts ContactAttempt[]
  promises PromiseToPay[]

  @@index([normalizedName])
  @@index([phone])
  @@index([economicTier])
}

// Which children a guardian pays for. A student may have more than one
// guardian row, but exactly one carries isPayer — that is the household the
// student's dues are chased through.
model GuardianStudent {
  id         Int              @id @default(autoincrement())
  guardianId Int
  studentId  Int
  relation   GuardianRelation @default(FATHER)
  isPayer    Boolean          @default(true)
  // How the link was made: "auto:name+phone", "auto:name", "manual", "solo".
  linkSource String?
  createdAt  DateTime         @default(now())

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([studentId])
}

// Derived behavioural profile — never written by a human, always recomputed
// (same contract as SyllabusPacing). Recomputing must be idempotent: the same
// ledger state must always produce the same row.
model GuardianProfile {
  id         Int @id @default(autoincrement())
  guardianId Int @unique

  archetype           PaymentArchetype @default(UNKNOWN)
  archetypeConfidence Int              @default(0) // 0–100
  suggestedTier       EconomicTier     @default(UNKNOWN)

  // 0–100. reliability = how dependably they settle what they owe, over their
  // whole history. propensity = how likely they are to pay in the next 30 days.
  // A chronic defaulter with an open promise scores low on one and high on the
  // other, which is exactly the case worth calling.
  reliabilityScore    Int     @default(0)
  propensityScore     Int     @default(0)
  expectedRecovery30d Decimal @default(0) @db.Decimal(12, 2)

  totalOutstanding  Decimal @default(0) @db.Decimal(12, 2)
  currentSessionDue Decimal @default(0) @db.Decimal(12, 2)
  pastSessionsDue   Decimal @default(0) @db.Decimal(12, 2)
  lifetimeBilled    Decimal @default(0) @db.Decimal(12, 2)
  lifetimePaid      Decimal @default(0) @db.Decimal(12, 2)

  sessionsTracked  Int @default(0)
  sessionsWithDues Int @default(0)
  rolloverStreak   Int @default(0)
  childrenCount    Int @default(0)

  lastPaymentAt         DateTime?
  lastPaymentAmount     Decimal?  @db.Decimal(12, 2)
  avgDaysToFirstPayment Int? // days from session start to their first rupee
  avgClearanceDay       Int? // day-of-session by which they typically clear
  onTimeInstallmentRate Int? // percent of installments paid by their due date
  avgDaysLate           Int?
  avgTicket             Decimal?  @db.Decimal(12, 2)

  // { "1": 0.05, ... "12": 0.20 } — share of lifetime collection by calendar
  // month. This is what "they always pay in January" is read from.
  monthHistogram Json?
  // string[] — the human-readable reasons behind archetype/scores, rendered
  // verbatim in the UI. The owner has to trust the ranking, so it must explain
  // itself rather than emit a bare number.
  evidence       Json?

  contactAttempts Int  @default(0)
  contactPickRate Int? // percent of attempts that reached a human
  promisesMade    Int  @default(0)
  promisesKept    Int  @default(0)

  calculatedAt DateTime @default(now())

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([archetype])
  @@index([propensityScore])
  @@index([expectedRecovery30d])
}

// Mutable workflow state for one household in one session. Separate from
// GuardianProfile because that table is wiped and rebuilt on every recompute,
// while this holds decisions a human made (snoozed, parked, pinned) that must
// survive it. Also the row the worklist query sorts and paginates over, so
// ranking stays in SQL rather than in memory.
model RecoveryCase {
  id         Int @id @default(autoincrement())
  guardianId Int
  sessionId  Int

  stage                 RecoveryStage @default(NEW)
  priorityScore         Int           @default(0)
  outstanding           Decimal       @default(0) @db.Decimal(12, 2)
  expectedRecoveryValue Decimal       @default(0) @db.Decimal(12, 2)

  // Why this household is off today's list, and until when. Written by the
  // suppression rules on recompute; always surfaced to the user rather than
  // silently hiding the row.
  suppressedUntil   DateTime?
  suppressionReason String?

  // Human decisions. snoozedUntil is "not now"; parkedReason is "confirmed
  // hardship, stop chasing and decide on a discount or plan instead".
  snoozedUntil  DateTime?
  parkedReason  String?
  // Explicitly put on a given day's call list, overriding the ranking.
  pinnedForDate DateTime? @db.Date

  nextActionAt    DateTime?
  lastContactAt   DateTime?
  contactCount    Int       @default(0)
  recoveredAmount Decimal   @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardian Guardian         @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  session  AcademicSession  @relation(fields: [sessionId], references: [id])
  contacts ContactAttempt[]

  @@unique([guardianId, sessionId])
  @@index([sessionId, stage])
  @@index([expectedRecoveryValue])
  @@index([pinnedForDate])
}

// One logged attempt to reach a household. Append-only in practice: an
// attempt that happened is a fact, and the contact history is the single best
// predictor the propensity model has.
model ContactAttempt {
  id         Int  @id @default(autoincrement())
  guardianId Int
  sessionId  Int?
  caseId     Int?

  channel  ContactChannel @default(CALL)
  outcome  ContactOutcome
  talkedTo String?
  notes    String?

  nextFollowUpAt DateTime?
  contactedAt    DateTime  @default(now())

  loggedById   Int? // User.id — soft reference, matching the teaching module
  loggedByName String?
  createdAt    DateTime @default(now())

  guardian Guardian         @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  session  AcademicSession? @relation(fields: [sessionId], references: [id])
  case     RecoveryCase?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  promise  PromiseToPay?

  @@index([guardianId, contactedAt])
  @@index([outcome])
  @@index([contactedAt])
}

// "I will pay ₹5,000 by the 12th." Kept as its own table rather than fields on
// ContactAttempt because whether a family KEEPS its promises is the strongest
// behavioural signal available, and it has to be queryable on its own:
// promises due today drive the call list, promises broken drive re-contact.
//
// Resolution is automatic — payments by the household between the promise and
// promisedFor + grace settle it (see src/lib/recovery/promises.ts).
model PromiseToPay {
  id          Int      @id @default(autoincrement())
  guardianId  Int
  sessionId   Int
  amount      Decimal  @db.Decimal(12, 2)
  promisedFor DateTime @db.Date

  status        PromiseStatus @default(OPEN)
  settledAmount Decimal       @default(0) @db.Decimal(12, 2)
  settledAt     DateTime?

  sourceContactId Int?    @unique
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardian      Guardian        @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  session       AcademicSession @relation(fields: [sessionId], references: [id])
  sourceContact ContactAttempt? @relation(fields: [sourceContactId], references: [id], onDelete: SetNull)

  @@index([guardianId])
  @@index([status, promisedFor])
}

// A dated snapshot of what the system expected to collect in a given month.
// Snapshots rather than a live number, so predicted-vs-actual can be measured
// and fed back as a calibration factor — a forecast nobody scores is a guess.
// One snapshot per (session, month, day) keeps the history bounded.
model CollectionForecast {
  id          Int      @id @default(autoincrement())
  sessionId   Int
  month       DateTime @db.Date // first day of the forecast month
  generatedOn DateTime @db.Date // the day this snapshot was taken
  generatedAt DateTime @default(now())

  // Three bands: committed = open promises + installments due from families
  // who reliably pay them; likely = propensity-weighted; stretch = everything
  // outstanding at a low probability.
  committed Decimal @db.Decimal(12, 2)
  likely    Decimal @db.Decimal(12, 2)
  stretch   Decimal @db.Decimal(12, 2)

  actualCollected   Decimal? @db.Decimal(12, 2)
  calibrationFactor Float    @default(1)
  breakdown         Json?

  session AcademicSession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, month, generatedOn])
  @@index([sessionId, month])
}

// Single-row tuning for the targeting rules. Every field here decides who does
// NOT get called, which is the part that saves effort — so they are settings a
// school owner can adjust, not constants buried in code.
model RecoveryConfig {
  id Int @id @default(1)

  cooldownDays             Int @default(5) // don't re-contact within N days
  justPaidSuppressDays     Int @default(7) // they just paid; leave them alone
  promiseGraceDays         Int @default(3) // days past promisedFor before it breaks
  noAnswerBackoffThreshold Int @default(3) // consecutive no-answers before backing off
  noAnswerBackoffDays      Int @default(7)

  minOutstanding  Decimal @default(500) @db.Decimal(12, 2) // ignore trivial dues
  dailyCallTarget Int     @default(30)

  // Optional overrides for the propensity weights; null = code defaults.
  scoreWeights Json?

  updatedById Int? // User.id — soft reference
  updatedAt   DateTime @updatedAt
}
